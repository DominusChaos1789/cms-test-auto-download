'LANGUAGE=ESO
'SERVERNAME=<CMS_SERVER_IP>
Public Sub Main()

On Error Resume Next

'FECHA AUTOMATICA (por defecto: ayer). Cambie DiasAtras si necesita otro dia.
DiasAtras = 1
d = DateAdd("d", -DiasAtras, Date)
Fec = Right("0" & Day(d), 2) & "/" & Right("0" & Month(d), 2) & "/" & Year(d)
Fec2 = Year(d) & Right("0" & Month(d), 2) & Right("0" & Day(d), 2)

'RANGOS DE AGENTE (compartidos por las 2 empresas: Telmex Hogar y EYN)
AG1="306000-307000"
AG2="307000-308000"
AG3="370000-371000"
AG4="372000-373000"
AG5="377000-378000"
AG6="373000-374000"
AG7="309000-310000"
AG8="303000-304000"
AG9="389000-390000"
AG10="390001-391000"

'===================== ADHERENCIA - [Call Center Telmex Hogar] =====================

'CARGUE ADH TELMEX HOGAR 1

    cvsSrv.Reports.ACD = 1
    Set Info = cvsSrv.Reports.Reports("Historical\Designer\[Call Center Telmex Hogar] Base_Tbl_Ag-N")

    If Info Is Nothing Then
        If cvsSrv.Interactive Then
            MsgBox "El reporte Historical\Designer\[Call Center Telmex Hogar] Base_Tbl_Ag-N no fue encontrado en la ACD 1.", vbCritical Or vbOKOnly, "Avaya CMS Supervisor"
        Else
            Set Log = CreateObject("ACSERR.cvsLog")
            Log.AutoLogWrite "El reporte Historical\Designer\[Call Center Telmex Hogar] Base_Tbl_Ag-N no fue encontrado en la ACD 1."
            Set Log = Nothing
        End If
    Else

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 0
            Rep.Window.Width = 0
            Rep.Window.Height = 0

            Rep.TimeZone = "default"

            Rep.SetProperty "Agentes",AG1

            Rep.SetProperty "Fecha",FEC

            Rep.SetProperty "Intervalo","00:00-23:45"

            b = Rep.ExportData("<FILE_SERVER_IP>\AdminInfo\<CLIENT>\08. ADHERENCIA <CLIENT> SAC\ADHERENCIA 1_"&FEC2&".txt", 9, 0, True, True, True)

            b = Rep.ExportData("<FILE_SERVER_IP_2B>\pruebas\ETL\AREAS DE APOYO\Avaya_Scripts_CMS\4_adherencia_masivo_empresas\ADHERENCIA 1_"&FEC2&".txt", 9, 0, True, True, True)

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing
        End If

    End If
    Set Info = Nothing


