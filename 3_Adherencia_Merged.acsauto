'LANGUAGE=ESO
'SERVERNAME=<CMS_SERVER_IP>

'=========================================================
' ADHERENCIA - Telmex Hogar (10 rangos) + EYN (10 rangos)
' Script automatico (.acsauto) para Avaya CMS Supervisor R21.
' Pensado para correr desatendido: sin InputBox, y los
' MsgBox solo aparecen si alguien lo corre a mano (modo
' interactivo). Las rutas de red y los nombres de reporte
' estan centralizados abajo en CONFIGURACION.
'=========================================================

Public Sub Main()

On Error Resume Next

'--------------------------------------------------------
' CONFIGURACION - rutas de red y reportes de Designer.
' Cada bloque escribe en 2 destinos: la carpeta antigua y
' la nueva carpeta ETL.
'--------------------------------------------------------
Const FILE_SERVER_TELMEX_OLD = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\08. ADHERENCIA CLARO SAC\"
Const FILE_SERVER_EYN_OLD    = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\15. ADHERENCIA CLARO EMPRESAS\"
Const FILE_SERVER_NEW        = "\\<FILE_SERVER_IP_2>\pruebas\ETL\AREAS DE APOYO\Avaya_Scripts_CMS\4_adherencia_masivo_empresas\"

Const REPORTE_TELMEX = "Historical\Designer\[Call Center Telmex Hogar] Base_Tbl_Ag-N"
Const REPORTE_EYN    = "Historical\Designer\EYN Base_Tbl_Ag-N"

'--------------------------------------------------------
' FECHA AUTOMATICA (por defecto: ayer).
'--------------------------------------------------------
DiasAtras = 1
d = DateAdd("d", -DiasAtras, Date)
Fec = Right("0" & Day(d), 2) & "/" & Right("0" & Month(d), 2) & "/" & Year(d)
Fec2 = Year(d) & Right("0" & Month(d), 2) & Right("0" & Day(d), 2)

'--------------------------------------------------------
' RANGOS DE AGENTE (compartidos por las 2 empresas)
'--------------------------------------------------------
AG1="306000-307000"
AG2="307000-308000"
AG3="370000-371000"
AG4="372000-373000"
AG5="377000-378000"
AG6="373000-374000"
AG7="309000-310000"
AG8="303000-304000"
AG9="389000-390000"
AG10="390001-391000"

'===================== ADHERENCIA - [Call Center Telmex Hogar] =====================


'=== CARGUE ADH TELMEX HOGAR 1 ===

    Set Info = GetReporte(REPORTE_TELMEX)

    If Not Info Is Nothing Then

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 0
            Rep.Window.Width = 0
            Rep.Window.Height = 0

            Rep.TimeZone = "default"

            Rep.SetProperty "Agentes",AG1

            Rep.SetProperty "Fecha",Fec

            Rep.SetProperty "Intervalo","00:00-23:45"

            ExportConLog Rep, FILE_SERVER_TELMEX_OLD & "ADHERENCIA 1_" & Fec2 & ".txt", "CARGUE ADH TELMEX HOGAR 1"
            ExportConLog Rep, FILE_SERVER_NEW & "ADHERENCIA 1_" & Fec2 & ".txt", "CARGUE ADH TELMEX HOGAR 1 (copia ETL)"

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing

        Else
            LogError "CARGUE ADH TELMEX HOGAR 1: no se pudo crear el reporte " & REPORTE_TELMEX & " - " & Err.Description
            Err.Clear
        End If

    End If
    Set Info = Nothing


'=== CARGUE ADH TELMEX HOGAR 2 ===

    Set Info = GetReporte(REPORTE_TELMEX)

    If Not Info Is Nothing Then

        b = cvsSrv.Reports.CreateReport(Info,Rep)

