R4SK2="<SKILL_IDS_ROIF_S4_2>"
R4SK3="<SKILL_IDS_ROIF_S4_3>"
R4SK4="<SKILL_IDS_ROIF_S4_4>"

' SKILL - script 5 original (-> CARGUE 11)
R5SK="<SKILL_IDS_ROIF_S5>"


'=== CARGUE 1 ===

    Set Info = GetReporte(REPORTE_ROIF)

    If Not Info Is Nothing Then

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 0
            Rep.Window.Width = 0
            Rep.Window.Height = 0

            Rep.TimeZone = "default"

            Rep.SetProperty "Splits/skills",R1SK1

            Rep.SetProperty "Fechas",fec

            Rep.SetProperty "Intervalo","00:00-23:45"

            ExportConLog Rep, FILE_SERVER_OLD & "CARGUE 1_" & Fec2 & ".txt", "CARGUE 1"

            ExportConLog Rep, FILE_SERVER_NEW & "CARGUE 1_" & Fec2 & ".txt", "CARGUE 1 (copia ETL)"

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing

        Else
            LogError "CARGUE 1: no se pudo crear el reporte " & REPORTE_ROIF & " - " & Err.Description
            Err.Clear
        End If

    End If
    Set Info = Nothing


'=== CARGUE 2 ===

    Set Info = GetReporte(REPORTE_ROIF)

