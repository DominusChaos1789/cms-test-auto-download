'LANGUAGE=ESO
'SERVERNAME=<CMS_SERVER_IP>
Public Sub Main()

On Error Resume Next

'--------------------------------------------------------
' CONFIGURACION - rutas de red y reportes de Designer.
' Edite solo aqui si cambia el servidor de archivos, las
' carpetas de destino o los nombres de los reportes.
'--------------------------------------------------------
FILE_SERVER_OLD = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\12. ROIF MENSUAL\"
FILE_SERVER_NEW = "\\<FILE_SERVER_IP_2>\pruebas\ETL\AREAS DE APOYO\Avaya_Scripts_CMS\3_roif_mensual_llamadas_asesor_skill\"
REPORTE_ROIF = "Historical\Designer\Validacion Skill Por Agente"

'FECHA AUTOMATICA (por defecto: ayer).
DiasAtras = 1
d = DateAdd("d", -DiasAtras, Date)
Fec = Right("0" & Day(d), 2) & "/" & Right("0" & Month(d), 2) & "/" & Year(d)
Fec2 = Year(d) & Right("0" & Month(d), 2) & Right("0" & Day(d), 2)

'SKILLS - script 1 original (4 lotes -> CARGUE 1,2,9,10)
R1SK1="<SKILL_IDS_ROIF_S1_1>"
R1SK2="<SKILL_IDS_ROIF_S1_2>"
R1SK3="<SKILL_IDS_ROIF_S1_3>"
R1SK4="<SKILL_IDS_ROIF_S1_4>"

'SKILL - script 2 original (-> CARGUE 3)
R2SK="<SKILL_IDS_ROIF_S2>"

'SKILL - script 3 original (-> CARGUE 4)
R3SK="<SKILL_IDS_ROIF_S3>"

'SKILLS - script 4 original (4 lotes -> CARGUE 5,6,7,8)
R4SK1="<SKILL_IDS_ROIF_S4_1>"
R4SK2="<SKILL_IDS_ROIF_S4_2>"
R4SK3="<SKILL_IDS_ROIF_S4_3>"
R4SK4="<SKILL_IDS_ROIF_S4_4>"

'SKILL - script 5 original (-> CARGUE 11)
R5SK="<SKILL_IDS_ROIF_S5>"


'=== CARGUE 1 ===

    cvsSrv.Reports.ACD = 1
    Set Info = cvsSrv.Reports.Reports(REPORTE_ROIF)

    If Info Is Nothing Then
        If cvsSrv.Interactive Then
            MsgBox "El reporte " & REPORTE_ROIF & " no fue encontrado en la ACD 1.", vbCritical Or vbOKOnly, "Avaya CMS Supervisor"
        Else
            Set Log = CreateObject("ACSERR.cvsLog")
            Log.AutoLogWrite "El reporte " & REPORTE_ROIF & " no fue encontrado en la ACD 1."
            Set Log = Nothing
        End If
    Else

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 0
            Rep.Window.Width = 0
            Rep.Window.Height = 0

            Rep.TimeZone = "default"

            Rep.SetProperty "Splits/skills",R1SK1

            Rep.SetProperty "Fechas",fec

            Rep.SetProperty "Intervalo","00:00-23:45"

                        b = Rep.ExportData(FILE_SERVER_OLD & "CARGUE 1_" & Fec2 & ".txt", 9, 0, True, True, True)

            If Not b Then
                Set Log = CreateObject("ACSERR.cvsLog")
                Log.AutoLogWrite "CARGUE 1: fallo la exportacion a " & FILE_SERVER_OLD & "CARGUE 1_" & Fec2 & ".txt"
                Set Log = Nothing
            End If

                        b = Rep.ExportData(FILE_SERVER_NEW & "CARGUE 1_" & Fec2 & ".txt", 9, 0, True, True, True)

            If Not b Then
                Set Log = CreateObject("ACSERR.cvsLog")
                Log.AutoLogWrite "CARGUE 1 (copia ETL): fallo la exportacion a " & FILE_SERVER_NEW & "CARGUE 1_" & Fec2 & ".txt"
                Set Log = Nothing
            End If

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing

        Else
            Set Log = CreateObject("ACSERR.cvsLog")
            Log.AutoLogWrite "CARGUE 1: no se pudo crear el reporte " & REPORTE_ROIF
            Set Log = Nothing
        End If

    End If
    Set Info = Nothing


