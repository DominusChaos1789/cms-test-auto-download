'LANGUAGE=ESO
'SERVERNAME=<CMS_SERVER_IP>

'=========================================================
' ROIF MENSUAL - 11 bloques CARGUE (5 scripts originales)
' Script automatico (.acsauto) para Avaya CMS Supervisor R21.
' Pensado para correr desatendido: sin InputBox, y los
' MsgBox solo aparecen si alguien lo corre a mano (modo
' interactivo). Las rutas de red y los nombres de reporte
' estan centralizados abajo en CONFIGURACION.
'=========================================================

Public Sub Main()

On Error Resume Next

'--------------------------------------------------------
' CONFIGURACION - rutas de red y reporte de Designer.
' Cada CARGUE escribe en 2 destinos: la carpeta antigua y
' la nueva carpeta ETL.
'--------------------------------------------------------
Const FILE_SERVER_OLD = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\12. ROIF MENSUAL\"
Const FILE_SERVER_NEW = "\\<FILE_SERVER_IP_2>\pruebas\ETL\AREAS DE APOYO\Avaya_Scripts_CMS\3_roif_mensual_llamadas_asesor_skill\"
Const REPORTE_ROIF = "Historical\Designer\Validacion Skill Por Agente"

'--------------------------------------------------------
' FECHA AUTOMATICA (por defecto: ayer).
'--------------------------------------------------------
DiasAtras = 1
d = DateAdd("d", -DiasAtras, Date)
Fec = Right("0" & Day(d), 2) & "/" & Right("0" & Month(d), 2) & "/" & Year(d)
Fec2 = Year(d) & Right("0" & Month(d), 2) & Right("0" & Day(d), 2)

'--------------------------------------------------------
' SKILLS - script 1 original (4 lotes -> CARGUE 1,2,9,10)
'--------------------------------------------------------
R1SK1="<SKILL_IDS_ROIF_S1_1>"
R1SK2="<SKILL_IDS_ROIF_S1_2>"
R1SK3="<SKILL_IDS_ROIF_S1_3>"
R1SK4="<SKILL_IDS_ROIF_S1_4>"

' SKILL - script 2 original (-> CARGUE 3)
R2SK="<SKILL_IDS_ROIF_S2>"

' SKILL - script 3 original (-> CARGUE 4)
R3SK="<SKILL_IDS_ROIF_S3>"

' SKILLS - script 4 original (4 lotes -> CARGUE 5,6,7,8)
