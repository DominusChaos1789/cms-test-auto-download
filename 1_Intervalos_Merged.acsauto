'LANGUAGE=ESO
'SERVERNAME=<CMS_SERVER_IP>
Public Sub Main()

On Error Resume Next

'FECHA AUTOMATICA. "Fec"/"Fec2" = ayer (usado por Intervalos y DEO).
'La Conexion trae ademas los 2 dias anteriores (-2, -3) en la misma sesion de reporte.
d1 = DateAdd("d", -1, Date)
FecD1 = Right("0" & Day(d1), 2) & "/" & Right("0" & Month(d1), 2) & "/" & Year(d1)
Fec2D1 = Year(d1) & Right("0" & Month(d1), 2) & Right("0" & Day(d1), 2)

d2 = DateAdd("d", -2, Date)
FecD2 = Right("0" & Day(d2), 2) & "/" & Right("0" & Month(d2), 2) & "/" & Year(d2)
Fec2D2 = Year(d2) & Right("0" & Month(d2), 2) & Right("0" & Day(d2), 2)

d3 = DateAdd("d", -3, Date)
FecD3 = Right("0" & Day(d3), 2) & "/" & Right("0" & Month(d3), 2) & "/" & Year(d3)
Fec2D3 = Year(d3) & Right("0" & Month(d3), 2) & Right("0" & Day(d3), 2)

Fec = FecD1
Fec2 = Fec2D1

'SKILLS POR GRUPO (uno por cada script de intervalos original)
SK1="<SKILL_IDS_INTERVALOS_1>"
SK2="<SKILL_IDS_INTERVALOS_2>"
SK3="<SKILL_IDS_INTERVALOS_3>"
SK4="<SKILL_IDS_INTERVALOS_4>"
SK5="<SKILL_IDS_INTERVALOS_5>"


'CONEXION 1 (trae ayer, antier y trasantier: -1/-2/-3 dias)

    cvsSrv.Reports.ACD = 1
    Set Info = cvsSrv.Reports.Reports("Historical\Designer\ConexiondesconexionDeocms")

    If Info Is Nothing Then
        If cvsSrv.Interactive Then
            MsgBox "El reporte Historical\Designer\ConexiondesconexionDeocms no fue encontrado en la ACD 1.", vbCritical Or vbOKOnly, "Avaya CMS Supervisor"
        Else
            Set Log = CreateObject("ACSERR.cvsLog")
            Log.AutoLogWrite "El reporte Historical\Designer\ConexiondesconexionDeocms no fue encontrado en la ACD 1."
            Set Log = Nothing
        End If
    Else

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 3855
            Rep.Window.Width = 20655
            Rep.Window.Height = 11700

            Rep.TimeZone = "default"

            Rep.SetProperty "Skill",SK1

            Rep.SetProperty "Fechas",FecD1

            b = Rep.ExportData("<FILE_SERVER_IP>\AdminInfo\<CLIENT>\13. LOG\LOGIN_1_"&Fec2D1&".txt", 9, 0, true, True, True)

            Rep.SetProperty "Fechas",FecD2

            b = Rep.ExportData("<FILE_SERVER_IP>\AdminInfo\<CLIENT>\13. LOG\LOGIN_1_"&Fec2D2&".txt", 9, 0, true, True, True)

            Rep.SetProperty "Fechas",FecD3

            b = Rep.ExportData("<FILE_SERVER_IP>\AdminInfo\<CLIENT>\13. LOG\LOGIN_1_"&Fec2D3&".txt", 9, 0, true, True, True)

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing
        End If

    End If
    Set Info = Nothing


'INTERVALOS 1

    cvsSrv.Reports.ACD = 1
    Set Info = cvsSrv.Reports.Reports("Historical\Designer\EYN Reporte Split/Skill x Intervalos")

    If Info Is Nothing Then
        If cvsSrv.Interactive Then
