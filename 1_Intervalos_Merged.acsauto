                Set Log = Nothing
            End If

            rep.quit
            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing

        Else
            Set Log = CreateObject("ACSERR.cvsLog")
            Log.AutoLogWrite "CONEXION 1 dia -3: no se pudo crear el reporte " & REPORTE_CONEXION
            Set Log = Nothing
        End If

    End If
    Set Info = Nothing


'=== INTERVALOS 1 ===

    cvsSrv.Reports.ACD = 1
    Set Info = cvsSrv.Reports.Reports(REPORTE_INTERVALOS)

    If Info Is Nothing Then
        If cvsSrv.Interactive Then
            MsgBox "El reporte " & REPORTE_INTERVALOS & " no fue encontrado en la ACD 1.", vbCritical Or vbOKOnly, "Avaya CMS Supervisor"
        Else
            Set Log = CreateObject("ACSERR.cvsLog")
            Log.AutoLogWrite "El reporte " & REPORTE_INTERVALOS & " no fue encontrado en la ACD 1."
            Set Log = Nothing
        End If
    Else

        b = cvsSrv.Reports.CreateReport(Info,Rep)

