'LANGUAGE=ESO
'SERVERNAME=<CMS_SERVER_IP>

'=========================================================
' INTERVALOS - 5 grupos (Conexion + Intervalos + DEO cada uno)
' Script automatico (.acsauto) para Avaya CMS Supervisor R21.
' Pensado para correr desatendido: sin InputBox, y los
' MsgBox solo aparecen si alguien lo corre a mano (modo
' interactivo). Las rutas de red y los nombres de reporte
' estan centralizados abajo en CONFIGURACION.
'=========================================================

Public Sub Main()

On Error Resume Next

'--------------------------------------------------------
' CONFIGURACION - rutas de red y reportes de Designer.
' Edite solo aqui si cambia el servidor de archivos o los
' nombres de los reportes.
'--------------------------------------------------------
Const FILE_SERVER_LOG        = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\13. LOG\"
Const FILE_SERVER_INTERVALOS = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\INTERVALOS\"
Const FILE_SERVER_DEO         = "\\<FILE_SERVER_IP>\AdminInfo\<CLIENT>\16. DEO\"
Const FILE_SERVER_WFM         = "\\<FILE_SERVER_IP_2B>\WorkForce\Torres\SAC\LOGIN\"
Const ARCHIVO_WFM             = "OCUPACION-INFNEWMOV.csv"

Const REPORTE_CONEXION   = "Historical\Designer\ConexiondesconexionDeocms"
Const REPORTE_INTERVALOS = "Historical\Designer\EYN Reporte Split/Skill x Intervalos"
Const REPORTE_DEO        = "Historical\Designer\Validacion Skill Por Agente P-1"

'--------------------------------------------------------
' FECHAS. "Fec"/"Fec2" = ayer (Intervalos y DEO).
' La Conexion trae ademas los 2 dias anteriores (-2,-3)
' en la misma sesion de reporte.
'--------------------------------------------------------
d1 = DateAdd("d", -1, Date)
FecD1 = Right("0" & Day(d1), 2) & "/" & Right("0" & Month(d1), 2) & "/" & Year(d1)
Fec2D1 = Year(d1) & Right("0" & Month(d1), 2) & Right("0" & Day(d1), 2)

d2 = DateAdd("d", -2, Date)
FecD2 = Right("0" & Day(d2), 2) & "/" & Right("0" & Month(d2), 2) & "/" & Year(d2)
Fec2D2 = Year(d2) & Right("0" & Month(d2), 2) & Right("0" & Day(d2), 2)

d3 = DateAdd("d", -3, Date)
FecD3 = Right("0" & Day(d3), 2) & "/" & Right("0" & Month(d3), 2) & "/" & Year(d3)
Fec2D3 = Year(d3) & Right("0" & Month(d3), 2) & Right("0" & Day(d3), 2)

Fec = FecD1
Fec2 = Fec2D1

'--------------------------------------------------------
' SKILLS POR GRUPO (uno por cada script de intervalos original)
'--------------------------------------------------------
SK1="<SKILL_IDS_INTERVALOS_1>"
SK2="<SKILL_IDS_INTERVALOS_2>"
SK3="<SKILL_IDS_INTERVALOS_3>"
SK4="<SKILL_IDS_INTERVALOS_4>"
SK5="<SKILL_IDS_INTERVALOS_5>"


'=== CONEXION 1 (trae ayer, antier y trasantier: -1/-2/-3 dias) ===

    Set Info = GetReporte(REPORTE_CONEXION)

    If Not Info Is Nothing Then

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 3855
            Rep.Window.Width = 20655
            Rep.Window.Height = 11700

            Rep.TimeZone = "default"

            Rep.SetProperty "Skill",SK1

            Rep.SetProperty "Fechas",FecD1
            ExportConLog Rep, FILE_SERVER_LOG & "LOGIN_1_" & Fec2D1 & ".txt", "CONEXION 1 dia -1"

            Rep.SetProperty "Fechas",FecD2
            ExportConLog Rep, FILE_SERVER_LOG & "LOGIN_1_" & Fec2D2 & ".txt", "CONEXION 1 dia -2"

            Rep.SetProperty "Fechas",FecD3
            ExportConLog Rep, FILE_SERVER_LOG & "LOGIN_1_" & Fec2D3 & ".txt", "CONEXION 1 dia -3"

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing

        Else
            LogError "CONEXION 1: no se pudo crear el reporte " & REPORTE_CONEXION & " - " & Err.Description
            Err.Clear
        End If

    End If
    Set Info = Nothing


'=== INTERVALOS 1 ===

    Set Info = GetReporte(REPORTE_INTERVALOS)

    If Not Info Is Nothing Then

        b = cvsSrv.Reports.CreateReport(Info,Rep)

        If b Then

            Rep.Window.Top = 0
            Rep.Window.Left = 0
            Rep.Window.Width = 0
            Rep.Window.Height = 0

            Rep.TimeZone = "default"

            Rep.SetProperty "Splits/skills",SK1

            Rep.SetProperty "Fechas",fec

            Rep.SetProperty "Intervalo","00:00-23:45"

            ExportConLog Rep, FILE_SERVER_INTERVALOS & "inervalo1_" & Fec2 & ".zervi", "INTERVALOS 1"

            rep.quit

            If Not cvsSrv.Interactive Then cvsSrv.ActiveTasks.Remove Rep.TaskID
            Set Rep = Nothing

