            Rep.Window.Left = 0
            Rep.Window.Width = 0
            Rep.Window.Height = 0

            Rep.TimeZone = "default"

            Rep.SetProperty "Splits/skills",SK1

            Rep.SetProperty "Fechas",fec

            Rep.SetProperty "Intervalo","00:00-23:45"

                        b = Rep.ExportData(FILE_SERVER_INTERVALOS & "inervalo1_" & Fec2 & ".zervi", 9, 0, True, True, True)

            If Not b Then
                Set Log = CreateObject("ACSERR.cvsLog")
                Log.AutoLogWrite "INTERVALOS 1: fallo la exportacion a " & FILE_SERVER_INTERVALOS & "inervalo1_" & Fec2 & ".zervi"
