'=========================================================
' FUNCIONES AUXILIARES - log y manejo de errores.
' Mismo comportamiento que antes (MsgBox solo si es
' interactivo; si no, log con ACSERR.cvsLog) pero ahora
' centralizado, y cada CreateReport/ExportData se revisa
' y queda registrado si falla, en vez de fallar en silencio.
'=========================================================

Sub LogInfo(msg)
    Dim Log
    Set Log = CreateObject("ACSERR.cvsLog")
    Log.AutoLogWrite msg
    Set Log = Nothing
End Sub

Sub LogError(msg)
    If cvsSrv.Interactive Then
        MsgBox msg, vbExclamation Or vbOKOnly, "Avaya CMS Supervisor"
    Else
        Dim Log
        Set Log = CreateObject("ACSERR.cvsLog")
        Log.AutoLogWrite msg
        Set Log = Nothing
    End If
End Sub

Function GetReporte(ruta)
    cvsSrv.Reports.ACD = 1
    Set GetReporte = cvsSrv.Reports.Reports(ruta)
    If GetReporte Is Nothing Then
        LogError "El reporte " & ruta & " no fue encontrado en la ACD 1."
    End If
End Function

Sub ExportConLog(rep, ruta, contexto)
    Dim ok
    ok = rep.ExportData(ruta, 9, 0, True, True, True)
    If Not ok Then
        LogError contexto & ": fallo la exportacion a """ & ruta & """ - " & Err.Description
        Err.Clear
    End If
End Sub
